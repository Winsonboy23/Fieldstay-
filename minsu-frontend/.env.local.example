# ---- Supabase ----
# 伺服器端用（anon key）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# 伺服器端管理操作用（service role key，絕對不可外流）
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# 瀏覽器端用（重設密碼頁），build 時會被打包進前端
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-key

# ---- NextAuth ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret
# 非 Vercel 環境（例如 Cloudflare Workers）需要
AUTH_TRUST_HOST=true

# ---- 後台 ----
# 後台（minsu-admin）的網址，用於內部 API 的 CORS
ADMIN_ORIGIN=http://localhost:5173
# 後台呼叫「已匯款通知」內部 API 用的共享密鑰（必須與 admin VITE_NOTIFY_SECRET 一致）
NOTIFY_SECRET=please-set-a-long-random-string
# 店家通知信收件信箱（新訂房／新報名／新訂單），逗號分隔多個
NOTIFY_EMAIL=

# ---- Email ----
# 寄信走 Cloudflare Email Service（wrangler.jsonc 的 send_email binding），不需要 API key；
# 寄件人必須是已驗證寄件網域底下的信箱
EMAIL_FROM=FIELDSTAY 山田寓所 <noreply@field-stay.com>
# Supabase Auth「Send Email Hook」的 webhook secret（v1,whsec_... 格式）
SUPABASE_EMAIL_HOOK_SECRET=

# ---- 綠界物流電子地圖（不填 = 綠界測試環境，固定回傳一間測試門市、不會真的跳地圖）----
# ECPAY_LOGISTICS_MAP_URL=https://logistics.ecpay.com.tw/Express/map
# ECPAY_LOGISTICS_MERCHANT_ID=你的綠界特店編號
