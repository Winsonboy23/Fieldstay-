SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_KEY=your-supabase-key

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Email 通知（Zeabur Email API）— 與 Supabase auth email-hook 共用
ZEABUR_EMAIL_API_KEY=your-zeabur-api-key
EMAIL_FROM=FIELDSTAY <noreply@field-stay.com>

# 後台呼叫「已匯款通知」內部 API 用的共享密鑰（必須與 admin VITE_NOTIFY_SECRET 一致）
NOTIFY_SECRET=please-set-a-long-random-string